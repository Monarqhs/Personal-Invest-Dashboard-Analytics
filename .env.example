# ─── Database ────────────────────────────────────────────────────────────────
# Direct connection (used for migrations via Alembic, dbt)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dashboard_dev

# PgBouncer transaction-pooling connection (used by FastAPI and pipelines at runtime)
# Supabase provides this on port 6543 — transaction mode, does NOT support DDL
DATABASE_POOL_URL=postgresql://postgres:postgres@localhost:6543/dashboard_dev

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_JWT_SECRET=<your-jwt-secret>

# ─── Frontend ────────────────────────────────────────────────────────────────
# API base URL accessible from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Auth (Phase 1: both false — scaffold only) ───────────────────────────────
# Set AUTH_ENFORCEMENT_ENABLED=true to require valid JWT on protected endpoints
AUTH_ENFORCEMENT_ENABLED=false
# Set RLS_ENABLED=true after enabling RLS policies in Supabase
RLS_ENABLED=false

# ─── Notifications ───────────────────────────────────────────────────────────
# Options: telegram | discord | slack | noop
NOTIFIER_TYPE=telegram
TELEGRAM_BOT_TOKEN=<your-bot-token>
TELEGRAM_CHAT_ID=<your-chat-id>

# ─── Archival Storage (Cloudflare R2) ────────────────────────────────────────
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=invest-dashboard-archive
# R2 S3-compatible endpoint
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# ─── Screener Plugin ─────────────────────────────────────────────────────────
# Path to private strategy module (e.g., private_strategies.registry)
# Leave empty to use only public reference strategies
PLUGIN_STRATEGY_PATH=

# ─── Cache ───────────────────────────────────────────────────────────────────
# Options: inmemory | upstash_redis
CACHE_PROVIDER=inmemory
# Required if CACHE_PROVIDER=upstash_redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Environment tag for log context
ENVIRONMENT=development
